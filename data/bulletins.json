[
  {
    "date": "2026-11-15",
    "title": "주일 예배 주보",
    "pages": [
      "bulletins/2026-11-15-1.png",
      "bulletins/2026-11-15-2.png"
    ],
    "text": {
      "issue": "통권 6권 44호",
      "leader": "김무성 목사",
      "verse": {
        "text": "여호와께서 자기 백성의 상처를 싸매시며 그들의 맞은 자리를 고치시는 날에는 달빛은 햇빛 같겠고 햇빛은 일곱 배가 되어 일곱 날의 빛과 같으리라",
        "ref": "이사야 30:26"
      },
      "order": [
        {
          "name": "예배로의 부름",
          "note": "벧전 2:9",
          "stand": true
        },
        {
          "name": "영광송",
          "note": "시편찬송가 73장",
          "stand": true
        },
        {
          "name": "성경봉독",
          "note": "공동체 성경읽기",
          "stand": true
        },
        {
          "name": "말씀해설",
          "note": "인도자"
        },
        {
          "name": "죄의 공적인 고백",
          "note": "다같이"
        },
        {
          "name": "목회기도",
          "note": "인도자"
        },
        {
          "name": "설교 본문 봉독",
          "note": "벧전 2:1–10",
          "stand": true
        },
        {
          "name": "설교",
          "note": "김무성 목사",
          "main": true
        },
        {
          "name": "설교후 찬송",
          "note": "찬송가 210장",
          "stand": true
        },
        {
          "name": "강복선언",
          "note": "민 6:24–26",
          "stand": true
        }
      ],
      "sermon": {
        "series": "벧전 3",
        "title": "버린 돌로 지으시는 집",
        "passage": "베드로전서 2:1–10",
        "preacher": "김무성 목사"
      },
      "sections": [
        {
          "title": "예배로의 부름",
          "ref": "베드로전서 2:9",
          "quote": "그러나 너희는 택하신 족속이요 왕 같은 제사장들이요 거룩한 나라요 그의 소유가 된 백성이니 이는 너희를 어두운 데서 불러 내어 그의 기이한 빛에 들어가게 하신 이의 아름다운 덕을 선포하게 하려 하심이라"
        },
        {
          "title": "영광송",
          "ref": "시편찬송가 73장 · 시편 34:1–5",
          "sub": "내가 항상 여호와를 찬양하오리니",
          "stanzas": [
            [
              "내가 항상 여호와를 찬양하오리니",
              "내 입술은 하나님을 송축하리로다"
            ],
            [
              "내 영혼이 여호와를 늘 자랑하리니",
              "곤고한 자 이를 듣고 기뻐하리로다"
            ],
            [
              "나와 함께 찬양하며 그 이름 높이세",
              "여호와는 광대하다 선포할지어다"
            ],
            [
              "여호와께 간구할 때 주 응답하시고",
              "나를 모든 환란에서 구원하리로다"
            ],
            [
              "주를 찾고 바라는 자 그 얼굴 빛나며",
              "영영토록 부끄럽지 아니하리로다"
            ]
          ]
        },
        {
          "title": "성경봉독",
          "ref": "공동체 성경읽기 · 44주차",
          "readings": [
            {
              "ref": "신명기 30:19–20",
              "version": "개역개정",
              "verses": [
                [
                  19,
                  "내가 오늘 하늘과 땅을 불러 너희에게 증거를 삼노라 내가 생명과 사망과 복과 저주를 네 앞에 두었은즉 너와 네 자손이 살기 위하여 생명을 택하고"
                ],
                [
                  20,
                  "네 하나님 여호와를 사랑하고 그의 말씀을 청종하며 또 그를 의지하라 그는 네 생명이시요 네 장수이시니 여호와께서 네 조상 아브라함과 이삭과 야곱에게 주리라고 맹세하신 땅에 네가 거주하리라"
                ]
              ]
            },
            {
              "ref": "누가복음 8:11–15",
              "version": "개역개정",
              "verses": [
                [
                  11,
                  "이 비유는 이러하니라 씨는 하나님의 말씀이요"
                ],
                [
                  12,
                  "길 가에 있다는 것은 말씀을 들은 자니 이에 마귀가 가서 그들이 믿어 구원을 얻지 못하게 하려고 말씀을 그 마음에서 빼앗는 것이요"
                ],
                [
                  13,
                  "바위 위에 있다는 것은 말씀을 들을 때에 기쁨으로 받으나 뿌리가 없어 잠깐 믿다가 시련을 당할 때에 배반하는 자요"
                ],
                [
                  14,
                  "가시떨기에 떨어졌다는 것은 말씀을 들은 자이나 지내는 중 이생의 염려와 재물과 향락에 기운이 막혀 온전히 결실하지 못하는 자요"
                ],
                [
                  15,
                  "좋은 땅에 있다는 것은 착하고 좋은 마음으로 말씀을 듣고 지키어 인내로 결실하는 자니라"
                ]
              ]
            }
          ]
        },
        {
          "title": "목회기도",
          "ref": "시편 118:22–24",
          "quote": "건축자가 버린 돌이 집 모퉁이의 머릿돌이 되었나니 이는 여호와께서 행하신 것이요 우리 눈에 기이한 바로다 이 날은 여호와께서 정하신 것이라 이 날에 우리가 즐거워하고 기뻐하리로다"
        },
        {
          "title": "설교",
          "ref": "벧전 3",
          "sermon": true
        },
        {
          "title": "설교후 찬송",
          "ref": "찬송가 210장",
          "sub": "시온성과 같은 교회",
          "stanzas": [
            [
              "시온성과 같은 교회 그의 영광 한없다",
              "허락하신 말씀대로 주가 친히 세웠다",
              "반석 위에 세운 교회 흔들 자가 누구랴",
              "모든 원수 에워싸도 아무 근심 없도다"
            ],
            [
              "생명샘이 솟아나와 모든 성도 마시니",
              "언제든지 흘러넘쳐 부족함이 없도다",
              "이런 물이 흘러가니 목마를 자 누구랴",
              "주의 은혜 풍족하여 넘치고도 넘친다"
            ],
            [
              "주의 은혜 내가 받아 시온 백성 되는 때",
              "세상 사람 비방해도 주를 찬송하리라",
              "세상 헛된 모든 영광 아침 안개 같으나",
              "주의 자녀 받을 복은 영원무궁 하도다 아멘"
            ]
          ]
        },
        {
          "title": "강복선언",
          "ref": "민수기 6:24–26",
          "quote": "여호와는 네게 복을 주시고 너를 지키시기를 원하며 여호와는 그의 얼굴을 네게 비추사 은혜 베푸시기를 원하며 여호와는 그 얼굴을 네게로 향하여 드사 평강 주시기를 원하노라"
        },
        {
          "title": "교회 소식",
          "news": [
            {
              "title": "주일 오후 모임 · 교회론 강의 시작",
              "body": "오늘부터 8주간 헤르만 바빙크의 『개혁교의학』을 바탕으로 교회론을 배웁니다. 첫 시간 주제는 ‘교회는 누구인가?’입니다"
            },
            {
              "title": "공동체 성경읽기 · 44주차",
              "body": "구약 신명기 29–34장 / 신약 누가복음 7–8장"
            }
          ]
        }
      ]
    }
  },
